# API mode (default)
MUAPI_API_KEY=your_muapi_key_here

# Local mode (--mode local)
LLM_PROVIDER=openai           # openai or gemini
OPENAI_API_KEY=your_openai_key_here
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-2.5-flash
LOCAL_WHISPER_MODEL=base
LOCAL_WHISPER_DEVICE=auto
LOCAL_OUTPUT_DIR=output

# Clipora SaaS
CLIPORA_SECRET_KEY=generate-a-long-random-secret
CLIPORA_DB_PATH=/data/clipora.db
CLIPORA_STORAGE_ROOT=/data
CLIPORA_WORKERS=1
CLIPORA_FREE_MONTHLY_JOBS=3

# Optional Railway S3-compatible Bucket
AWS_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=
AWS_DEFAULT_REGION=auto

# Optional Stripe Pro subscription
STRIPE_SECRET_KEY=
STRIPE_PRO_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
